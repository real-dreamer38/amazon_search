# ─── Arbitrage-X 환경변수 템플릿 ───────────────────────────────────────────
# 이 파일을 .env로 복사하고 실제 값을 입력하세요.
# cp .env.example .env

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/arbitrage_x.db
# PostgreSQL 사용 시: postgresql://user:password@localhost:5432/arbitrage_x

# ─── Amazon SP-API ─────────────────────────────────────────────────────────
SP_API_REFRESH_TOKEN=
SP_API_LWA_APP_ID=
SP_API_LWA_CLIENT_SECRET=
SP_API_AWS_ACCESS_KEY=
SP_API_AWS_SECRET_KEY=
SP_API_ROLE_ARN=
SP_API_MARKETPLACE_ID=ATVPDKIKX0DER

# ─── UPS API ───────────────────────────────────────────────────────────────
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# ─── Naver Shopping API ─────────────────────────────────────────────────────
# https://developers.naver.com/apps 에서 앱 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── Telegram Bot ──────────────────────────────────────────────────────────
# BotFather에서 봇 생성 후 토큰 입력
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Company Info (Invoice) ─────────────────────────────────────────────────
COMPANY_NAME=Your Company LLC
COMPANY_ADDRESS=123 Main St, City, State 00000
COMPANY_EMAIL=contact@yourcompany.com
COMPANY_PHONE=+1-000-000-0000
